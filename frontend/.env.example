# Copy to .env.local and adjust.
# Backend base URL; all API paths are appended to it. The dev server proxies /api to
# http://localhost:8080, so the default works with the backend running locally.
VITE_API_BASE_URL=/api/v1
# true = in-browser mock data (src/api/mocks), false = call the backend (staff must sign in).
VITE_USE_MOCKS=true
