# ReturnRight secrets — the ONLY place secret values live.
# Copy to .env (git-ignored) and change every value:   cp .env.example .env
# or generate random ones:                             infra/scripts/init-env.ps1   (or init-env.sh)
# Docker Compose reads .env automatically; the Spring apps import it when run from the repo (spring.config.import).
# The values below are DEV-ONLY placeholders so CI and a fresh clone work. Never reuse them anywhere real.

# PostgreSQL roles (created on the FIRST start of the db volume; change them => `docker compose down -v`)
RR_OWNER_DB_PASSWORD=change-me-owner-db
RR_APP_DB_PASSWORD=change-me-app-db
RR_READONLY_DB_PASSWORD=change-me-readonly-db

# Redis (lockout, rate limits, token revocation)
RR_REDIS_PASSWORD=change-me-redis

# JWT signing key, HS256: at least 32 characters
RR_JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long

# Mock payment gateway admin API (fault injection, data reset)
GATEWAY_ADMIN_TOKEN=change-me-gateway-admin

# Password the seeder gives every staff account (warehouse1, finance1, manager1, admin, ...)
RR_SEED_STAFF_PASSWORD=Change-Me-Staff-1

# Admin UIs
PGADMIN_PASSWORD=change-me-pgadmin
GRAFANA_PASSWORD=change-me-grafana
