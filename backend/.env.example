# Copy to .env and fill in local values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5433/returnright
# Host port for the Postgres container in deploy/docker-compose.yml
DB_HOST_PORT=5433
DB_USERNAME=returnright
DB_PASSWORD=dummy-db-password
SERVER_PORT=8080

# Mock payment gateway (separate service)
GATEWAY_BASE_URL=http://localhost:8090
GATEWAY_TIMEOUT=PT3S

# Seeded staff users (HTTP Basic): warehouse, finance, operations
WAREHOUSE_PASSWORD=dummy-warehouse-password
FINANCE_PASSWORD=dummy-finance-password
OPERATIONS_PASSWORD=dummy-operations-password
