    {
      "type": "barchart",
      "title": "Return rate by category (%)",
      "id": 20,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "returnright-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "returnright-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.name AS category, round(100.0 * count(ri.id) FILTER (WHERE ri.status <> 'CANCELLED') / NULLIF(sum(oi.quantity),0), 2) AS return_rate\nFROM categories c JOIN products p ON p.category_id = c.id JOIN order_items oi ON oi.product_id = p.id JOIN orders o ON o.id = oi.order_id AND o.status = 'DELIVERED'\nLEFT JOIN return_items ri ON ri.order_item_id = oi.id GROUP BY c.name ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
