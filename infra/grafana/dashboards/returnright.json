    {
      "type": "table",
      "title": "Flagged customers",
      "id": 22,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "returnright-pg"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "returnright-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT cu.full_name AS customer, cu.flagged_at, cu.flag_reason, count(r.id) FILTER (WHERE r.created_at > now() - interval '30 days') AS returns_30d\nFROM customers cu LEFT JOIN returns r ON r.customer_id = cu.id WHERE cu.is_flagged GROUP BY cu.id ORDER BY cu.flagged_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
